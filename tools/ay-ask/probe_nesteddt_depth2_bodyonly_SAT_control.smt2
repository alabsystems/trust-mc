(set-logic HORN)
(declare-datatypes ((Inner 0)) (((Inner_mk (i0 (_ BitVec 64))))))
(declare-datatypes ((Outer 0)) (((Outer_mk (o0 Inner)))))
(declare-var p Outer)
(declare-var q Outer)
(declare-var b (_ BitVec 8))
(declare-rel P ((_ BitVec 8)))
(declare-rel error ())
(rule (=> (and (= b #x01) (= q p)) (P b)))
(rule (=> (and (P b) (not (= b #xf0))) error))
(query error)
