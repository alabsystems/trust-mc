(set-logic HORN)
(declare-datatypes ((Inner 0)) (((Inner_mk (i0 (_ BitVec 64))))))
(declare-datatypes ((Outer 0)) (((Outer_mk (o0 Inner)))))
(declare-var p Outer)
(declare-var b (_ BitVec 8))
(declare-rel P (Outer (_ BitVec 8)))
(declare-rel error ())
(rule (=> (= b #x01) (P p b)))
(rule (=> (and (P p b) (not (= b #xf0))) error))
(query error)
