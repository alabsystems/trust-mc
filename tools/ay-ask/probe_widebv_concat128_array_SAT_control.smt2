(set-logic HORN)
(declare-var a (Array (_ BitVec 32) Bool))
(declare-var ao (Array (_ BitVec 32) Bool))
(declare-var w (_ BitVec 128))
(declare-var wo (_ BitVec 128))
(declare-rel error ())
(declare-rel ep ())
(rule (=> (and (= ao (store a #x00000029 true)) (= wo (concat #x0000000000000001 #x0000000000000001))) ep))
(rule (=> ep error))
(query error)
