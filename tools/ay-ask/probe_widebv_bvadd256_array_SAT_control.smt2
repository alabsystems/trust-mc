(set-logic HORN)
(declare-var a (Array (_ BitVec 32) Bool))
(declare-var ao (Array (_ BitVec 32) Bool))
(declare-var w (_ BitVec 256))
(declare-var wo (_ BitVec 256))
(declare-rel error ())
(declare-rel ep ())
(rule (=> (and (= ao (store a #x00000029 true)) (= wo (bvadd w w))) ep))
(rule (=> ep error))
(query error)
